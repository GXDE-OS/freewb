[基本设置/codeRemind]
Description=编码提示
Type=Boolean
DefaultValue=True

[基本设置/autoAdjustFreq]
Description=启用自动调序
Type=Boolean
DefaultValue=False

[基本设置/wordThink]
Description=启用词组联想
Type=Boolean
DefaultValue=False

[基本设置/remindExistWord]
Description=已有词组提示
Type=Boolean
DefaultValue=False

[基本设置/alertWhenEmptyCode]
Description=空重码提醒
Type=Boolean
DefaultValue=False

[基本设置/enterClear]
Description=回车清空编码
Type=Boolean
DefaultValue=True


[基本设置/shiftCommitChar]
Type=Boolean
DefaultValue=False
Description=shift+字母上屏


[快捷键/onlineAddWord]
Type=Hotkey
DefaultValue=CTRL+KEY_EQUAL
Description=在线造词

[快捷键/onlineDelWord]
Type=Hotkey
DefaultValue=CTRL+KEY_DASH
Description=在线删词

[快捷键/backFindCode]
Description=在线查询
Type=Hotkey
DefaultValue=CTRL+KEY_SLASH

[快捷键/setupOption]
Description=打开系统设置
Type=Hotkey
DefaultValue=CTRL+KEY_COMMA

[快捷键/switchInputMode]
Description=切换输入模式
Type=Hotkey
DefaultValue=CTRL+KEY_BACK_SLASH

[快捷键/switchChttrans]
Description=切换简繁模式
Type=Hotkey
DefaultValue=CTRL+KEY_J

[快捷键/tempPinyin]
Description=临时拼音键
Type=Hotkey
DefaultValue=0

[快捷键/tempEnglish]
Description=临时英文键
Type=Hotkey
DefaultValue=KEY_SEMICOLON

[快捷键/shortcutInput]
Description=快捷输入键
Type=Hotkey
DefaultValue=0

[快捷键/switchCharSet]
Description=切换字符集
Type=Hotkey
DefaultValue=CTRL+KEY_M

[快捷键/switchVKb]
Description=切换软键盘
Type=Hotkey
DefaultValue=SHIFT+KEY_ESC

[快捷键/quickDelScreenItem]
Description=快删上屏内容
Type=Hotkey
DefaultValue=CTRL+KEY_BACKSPACE


[候选项/secondRecodeKey]
Description=第二候选项
Type=Hotkey
DefaultValue=;

[候选项/thirdRecodeKey]
Description=第三候选项
Type=Hotkey
DefaultValue='

[候选项/candiWordCount]
Description=候选项数
Type=Integer
DefaultValue=3
Min=1
Max=10

[候选项/nextPageKey]
Description=向后翻页键
Type=Hotkey
DefaultValue==

[候选项/prevPageKey]
Description=向前翻页键
Type=Hotkey
DefaultValue=-

[候选项/useFreewbFont]
Description=使用极点自带字库
Type=Boolean
DefaultValue=False

[DescriptionFile]
LocaleDomain=fcitx