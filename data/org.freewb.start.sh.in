#!/bin/bash
if [ ! -d $HOME/.local/freewb ];then
	mkdir $HOME/.local/freewb -p
fi

if [ ! -d $HOME/.local/freewb/data ];then
	cp @CMAKE_INSTALL_PREFIX@/share/freewb/data $HOME/.local/freewb/ -r
fi

# run freewb

desktop_env=$(echo "$XDG_CURRENT_DESKTOP" | tr '[:upper:]' '[:lower:]')
session_type=$(echo "$XDG_SESSION_TYPE" | tr '[:upper:]' '[:lower:]')

if [[ "$desktop_env" == *"ukui"* ]] && [[ "$session_type" == "wayland" ]]; then
    @FREEWB_INSTALL_BINDIR@/@PROJECT_NAME@-panel
else
    export QT_QPA_PLATFORM=xcb
    @FREEWB_INSTALL_BINDIR@/@PROJECT_NAME@-panel
    unset QT_QPA_PLATFORM
fi
